<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_salon_appointment" model="ir.sequence">
            <field name="name">Booking Salon Sequence</field>
            <field name="code">salon.appointment</field>
            <field name="prefix">BOK/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_salon_warranty_claim" model="ir.sequence">
            <field name="name">Klaim Retouch Salon Sequence</field>
            <field name="code">salon.warranty.claim</field>
            <field name="prefix">RET/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
