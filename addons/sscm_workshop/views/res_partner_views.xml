<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_workshop" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.workshop</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_open_workshop_orders" icon="fa-wrench">
                    <field string="Bengkel" name="workshop_order_count" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Kendaraan Milik" name="customer_vehicles">
                    <field name="vehicle_ids">
                        <tree string="Kendaraan Pelanggan">
                            <field name="license_plate"/>
                            <field name="model_id"/>
                            <field name="odometer_last"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
