<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_sscm_salon" model="ir.module.category">
            <field name="name">Salon &amp; Klinik Kecantikan</field>
            <field name="description">Akses Manajemen Salon, Booking Kursi, dan Treatment Card</field>
            <field name="sequence">22</field>
        </record>

        <record id="group_salon_user" model="res.groups">
            <field name="name">Terapis / Stylist</field>
            <field name="category_id" ref="module_category_sscm_salon"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_salon_manager" model="res.groups">
            <field name="name">Manager Salon &amp; Klinik</field>
            <field name="category_id" ref="module_category_sscm_salon"/>
            <field name="implied_ids" eval="[(4, ref('group_salon_user')), (4, ref('sscm_core.group_sscm_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
